 index.html          |   6 +++---
 msat-viirs-maps.png | Bin 423971 -> 146698 bytes
 2 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/index.html b/index.html
index d457793..a854871 100644
--- a/index.html
+++ b/index.html
@@ -3,8 +3,8 @@
 <head>
 <meta charset="utf-8">
 <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
-<title>Leonardo Di Tommaso</title>
-<meta name="description" content="Leonardo Di Tommaso: physics student at Harvard working on satellite remote sensing, radiative transfer, and machine-learning bias correction for greenhouse gas retrievals.">
+<title>Leonardo Di Tommaso · Research & Data Science</title>
+<meta name="description" content="Leonardo Di Tommaso, Harvard physics student seeking summer 2027 research and data science internships. Satellite remote sensing, radiative transfer, and machine-learning bias correction for greenhouse gas retrievals.">
 <link rel="preconnect" href="https://fonts.googleapis.com">
 <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
 <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700&family=Public+Sans:ital,wght@0,400;0,600;1,400&family=JetBrains+Mono:wght@400;500&display=swap">
@@ -50,7 +50,7 @@ nav ul a:hover{color:var(--accent)}
 
 /* hero */
 .hero{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(0,1fr);gap:40px;align-items:end;padding-block:64px 40px}
-.hero h1{font-size:clamp(2.3rem,5.4vw,3.9rem);font-weight:700;letter-spacing:-.02em}
+.hero h1{font-size:clamp(2.2rem,4.6vw,3.3rem);font-weight:700;letter-spacing:-.02em}
 .hero .lede{margin-top:20px;max-width:56ch;font-size:1.1rem;color:var(--muted)}
 .hero .lede strong{color:var(--fg);font-weight:600}
 .links{display:flex;flex-wrap:wrap;gap:10px;margin-top:28px}
